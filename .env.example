# Copy to .env (git-ignored). Read by docker compose and by `pnpm dev:*`.

# --- Claude ------------------------------------------------------------------
ANTHROPIC_API_KEY=
AGENT_PLANNER_MODEL=claude-sonnet-5-5
DRIVER_EVALUATOR_MODEL=claude-opus-5-5

# --- Jev (button visibility checks) -----------------------------------------
# Required unless AGENT_PERCEPTION_JEV=false (then in-frame buttons count as seen).
TYPESAFE_API_KEY=
AGENT_PERCEPTION_JEV=true

# --- Driver ------------------------------------------------------------------
# Encoded into the QR code: must be reachable from the phone (use your LAN IP).
DRIVER_PUBLIC_URL=http://192.168.1.10:8000
DRIVER_AGENT_COUNT=5
# Host the visualizer uses to reach agent frame sockets.
DRIVER_AGENT_ADVERTISE_HOST=localhost
# hosted = firmware host service (Pi / compose); local = each agent spawns its own emulator
DRIVER_FIRMWARE_MODE=hosted
# Pi: http://raspberrypi.local:8100 (shows up as a pump on the visualizer's Connect screen)
DRIVER_FIRMWARE_HOST_URL=http://localhost:8100
DRIVER_REDIS_URL=redis://localhost:6379/0

# --- Firmware host -----------------------------------------------------------
FIRMWARE_MAX_INSTANCES=16

# --- Visualizer (Vite) -------------------------------------------------------
VITE_DRIVER_URL=http://localhost:8000

# --- Docker on Linux: match host user so ./data stays writable ---------------
# DOCKER_UID=1000
# DOCKER_GID=1000
# --- Docker compose: log level for all services ------------------------------
LOG_LEVEL=INFO
